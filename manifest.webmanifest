---
layout: null
---
{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "description": "{{ site.description | strip }}",
  "lang": "{{ site.lang }}",
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#fbf8f2",
  "theme_color": "#c9531f",
  "icons": [
    { "src": "{{ '/assets/icons/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "{{ '/assets/icons/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
